# Copy to .env for Docker Compose, then insert your own generated random key.
# No default key is shipped. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
API_PORT=8000
API_MAX_CONCURRENT=2
API_MAX_SESSIONS=100
API_SESSION_TTL_SECONDS=1800
API_REQUEST_TIMEOUT_SECONDS=125
# Local Python defaults to loopback; Compose uses its internal ollama service.
OLLAMA_HOST=http://127.0.0.1:11434
